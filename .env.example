DATABASE_URL=postgres://postgres:postgres@localhost:5432/rags
# Reads run as the restricted role so row-level security applies (created by sql/002_acl_rls.sql). Unset = owner connection, WHERE-clause filtering only.
APP_DATABASE_URL=postgres://rag_app:rag_app@localhost:5432/rags
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# EMBED_PROVIDER=openai | fake   (fake = deterministic hash vectors, no key needed; for tests/CI only)
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small
ANSWER_MODEL=claude-sonnet-5-5
# Tracing (optional): set all three to send one trace per `pnpm ask` to Langfuse (EU cloud free tier or self-hosted)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Reranking (optional): RERANK_MODEL is a Transformers.js cross-encoder id (local, free); COHERE_API_KEY enables `--rerank=cohere`
# RERANK_MODEL=Xenova/bge-reranker-base
# COHERE_API_KEY=...
# COHERE_RERANK_MODEL=rerank-v3.5
# Judge (week 6): a different model than ANSWER_MODEL avoids self-grading; prices in € per million tokens for the cost column
# JUDGE_MODEL=claude-opus-5-5
# PRICE_INPUT_PER_MTOK=3
# PRICE_OUTPUT_PER_MTOK=15
