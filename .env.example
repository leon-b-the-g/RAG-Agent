DATABASE_URL=postgres://postgres:postgres@localhost:5432/rags
# Reads run as the restricted role so row-level security applies (created by sql/002_acl_rls.sql). Unset = owner connection, WHERE-clause filtering only.
APP_DATABASE_URL=postgres://rag_app:rag_app@localhost:5432/rags

# Embeddings. EMBED_PROVIDER=voyage | openai | fake   (fake = deterministic hash vectors, no key needed; tests/CI only)
# voyage-4 (1024d, multilingual, 200M free tokens) is the default; openai text-embedding-3-small is 1536d.
# EMBED_DIM must match the model; `pnpm db:migrate` resizes the column, changing it later means re-ingesting.
EMBED_PROVIDER=voyage
EMBED_MODEL=voyage-4
EMBED_DIM=1024
VOYAGE_API_KEY=pa-...
# OPENAI_API_KEY=sk-...

# Generation + judge + query expansion (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANSWER_MODEL=claude-sonnet-5-5
# ANSWER_K=10                      excerpts handed to the model
# QUERY_MODEL=claude-haiku-4-5     RAG-fusion paraphrases (tuning.multiQuery / --multi-query=2)

# Ingestion (week 7)
# CONTEXTUALIZE=structural | llm   structural = "title › section" prefix (free); llm = one Haiku sentence per chunk, prompt-cached
# CONTEXT_MODEL=claude-haiku-4-5
# OCR_LANGS=deu+eng                tesseract.js languages for scanned PDF pages and images
# OCR_CACHE=/tmp/tesseract         where downloaded language data is kept
# OCR_LANG_PATH=                   offline: folder with <lang>.traineddata instead of the CDN

# Reranking (optional): `--rerank=voyage|cohere|local|overlap`; local = Transformers.js cross-encoder, free
# VOYAGE_RERANK_MODEL=rerank-2.5
# COHERE_API_KEY=...
# COHERE_RERANK_MODEL=rerank-v3.5
# RERANK_MODEL=Xenova/bge-reranker-base

# Tracing (optional): set all three to send one trace per `pnpm ask` to Langfuse (EU cloud free tier or self-hosted)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Judge (week 6): a different model than ANSWER_MODEL avoids self-grading; prices in € per million tokens for the cost column
# JUDGE_MODEL=claude-opus-5-5
# PRICE_INPUT_PER_MTOK=3
# PRICE_OUTPUT_PER_MTOK=15

# HTTP server (`pnpm serve`): binds to loopback; the API trusts tenant/principals in the body, so only expose it behind an auth proxy
# PORT=3000
# HOST=127.0.0.1
